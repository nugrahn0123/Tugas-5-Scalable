[mysqld]
# ==========================================
#  SLAVE CONFIGURATION - Master-Slave Demo
# ==========================================

server-id             = 2

# Binary log di slave (diperlukan untuk relay)
log_bin               = mysql-bin
relay_log             = relay-bin

# Slave hanya bisa dibaca (tidak menerima write langsung)
read_only             = ON
super_read_only       = ON

# Catat update yang diterima dari master ke binlog sendiri
log_replica_updates   = ON
