[mysqld]
# ==========================================
#  NODE 1 CONFIGURATION - Master-Master Demo
# ==========================================

server-id                  = 1
log_bin                    = mysql-bin
binlog_format              = ROW
relay_log                  = relay-bin
log_replica_updates        = ON

# Kedua node menerima WRITE
read_only                  = OFF

# Mencegah konflik Primary Key antar node:
# Node1 menghasilkan ID ganjil: 1, 3, 5, 7, ...
auto_increment_increment   = 2
auto_increment_offset      = 1

expire_logs_days           = 7
max_binlog_size            = 100M
