[mysqld]
# ==========================================
#  NODE 2 CONFIGURATION - Master-Master Demo
# ==========================================

server-id                  = 2
log_bin                    = mysql-bin
binlog_format              = ROW
relay_log                  = relay-bin
log_replica_updates        = ON

# Kedua node menerima WRITE
read_only                  = OFF

# Mencegah konflik Primary Key antar node:
# Node2 menghasilkan ID genap: 2, 4, 6, 8, ...
auto_increment_increment   = 2
auto_increment_offset      = 2

expire_logs_days           = 7
max_binlog_size            = 100M
